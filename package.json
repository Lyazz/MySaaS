{
  "name": "Swekly",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:fork": "nuxt dev",
    "dev:no-fork": "nuxt dev --no-fork",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "mobile:build": "cross-env NUXT_SSR=false nuxt generate",
    "mobile:sync": "npm run mobile:build && npx cap sync",
    "mobile:add:android": "npx cap add android",
    "mobile:open:android": "npx cap open android",
    "mobile:run:android": "npm run mobile:sync && npx cap run android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:open:ios": "npx cap open ios",
    "mobile:run:ios": "npm run mobile:sync && npx cap run ios",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down"
  },
