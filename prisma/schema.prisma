generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  isSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users          User[]
  customers      Customer[]
  subscription   TenantSubscription?
  payments       BillingPayment[]
  products       Product[]
  productImages  ProductImage[]
  productOptions ProductOption[]
  optionValues   ProductOptionValue[]
  variants       ProductVariant[]
  variantValues  ProductVariantOptionValue[]
  variantImages  ProductVariantImage[]
  inventoryMoves InventoryMovement[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  categories     Category[]
  orders         Order[]
  orderItems     OrderItem[]
  sales          Sale[]
  saleItems      SaleItem[]
  shipments      Shipment[]
  deliveryRates  DeliveryRate[]
  storeSettings  StoreSettings?
  contactInfos   TenantContactInfo[]
  domains        TenantDomain[]
  shipmentEvents ShipmentEvent[]             @relation("TenantShipmentEvents")
}

model TenantSubscription {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planCode String // from shared pricing catalog (e.g. basic, merchant, professional)
  interval String @default("month") // month | year
  status   String @default("ACTIVE") // TRIALING | ACTIVE | CANCELED | PAST_DUE ...

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  trialEnd           DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planCode])
}

model BillingPayment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planCode String
  interval String @default("month") // month | year

  amountDzd Int
  currency  String @default("DA")

  method String @default("SIMULATED") // SIMULATED | MANUAL_PROOF
  status String @default("PAID") // PAID | PENDING | REJECTED | IMPORTED

  proofUrl          String?
  notes             String?
  externalReference String?

  createdByUserId  String?
  reviewedByUserId String?

  periodStart DateTime?
  periodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model TenantDomain {
  id       String @id @default(uuid())
  domain   String @unique
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model StoreSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  logoUrl      String? // URL of the tenant's store logo
  primaryColor String  @default("#0d9488") // teal-600
  templateKey  String  @default("modern") // e.g. classic | modern
  fontFamily   String  @default("Outfit")
  language     String  @default("fr") // ar | fr | en

  announcementText      String?
  announcementScrolling Boolean @default(false)

  // Storefront homepage configuration (carousel + sections).
  // Tenant-scoped via StoreSettings. Treated as an opaque JSON blob but validated at the API layer.
  homeConfig Json?

  cartEnabled     Boolean @default(true)
  codEnabled      Boolean @default(true)
  currencyCode    String  @default("DZD") // ISO currency code
  currencyCountry String  @default("DZ") // ISO country for flag/locale

  isCompleted              Boolean  @default(false)
  allowedDeliveryProviders String[] @default(["SELF"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantContactInfo {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind  String
  label String?
  value String

  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, kind])
  @@index([tenantId, position])
}

model User {
  id           String   @id @default(uuid())
  email        String
  passwordHash String?
  role         String   @default("staff") // owner, admin, staff
  isSuperAdmin Boolean  @default(false)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inventoryMovements InventoryMovement[]
  purchaseOrdersCreated PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  salesCreated Sale[] @relation("SaleCreatedBy")

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Category {
  id       String  @id @default(uuid())
  title    String
  slug     String
  imageUrl String?
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Product {
  id              String  @id @default(uuid())
  title           String
  slug            String
  description     String?
  miniDescription String?
  price           Decimal @default(0)
  stock           Int     @default(0)

  isActive      Boolean        @default(true)
  images        String[]       @default([]) // Deprecated: Use ProductImage model
  productImages ProductImage[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [tenantId, categoryId], references: [tenantId, id])

  options  ProductOption[]
  variants ProductVariant[]

  orderItems OrderItem[]
  saleItems  SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model ProductImage {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)
  isMain    Boolean @default(false)

  variants ProductVariantImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model ProductOption {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  name        String // e.g. "Color", "Size"
  position    Int     @default(0)
  displayType String  @default("dropdown") // dropdown, button, color, image

  values ProductOptionValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model ProductOptionValue {
  id       String        @id @default(uuid())
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  optionId String
  option   ProductOption @relation(fields: [tenantId, optionId], references: [tenantId, id], onDelete: Cascade)
  label    String // e.g. "Red", "XL"
  position Int           @default(0)
  meta     String? // JSON string for swatch colors, etc.

  variantValues ProductVariantOptionValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, optionId])
}

model ProductVariant {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  sku            String?
  price          Decimal  @default(0)
  compareAtPrice Decimal?
  cost           Decimal  @default(0) // prix d'achat (latest unit cost)
  isActive       Boolean  @default(true)

  // Inventory
  trackInventory Boolean @default(true)
  stock          Int     @default(0) // available
  reserved       Int     @default(0)
  safetyStock    Int     @default(0)

  optionValues ProductVariantOptionValue[]
  images       ProductVariantImage[]
  movements    InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  orderItems   OrderItem[]
  saleItems    SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model ProductVariantOptionValue {
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant     @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [tenantId, optionValueId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, variantId, optionValueId])
  @@index([tenantId])
  @@index([optionValueId])
}

model ProductVariantImage {
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  imageId   String
  image     ProductImage   @relation(fields: [tenantId, imageId], references: [tenantId, id], onDelete: Cascade)
  position  Int            @default(0)

  @@id([tenantId, variantId, imageId])
  @@index([tenantId])
  @@index([imageId])
}

model InventoryMovement {
  id        String         @id @default(uuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  type      InventoryMovementType @default(MANUAL_ADJUSTMENT)
  delta     Int // stock delta
  reservedDelta Int @default(0)
  safetyStockDelta Int @default(0)
  reason    String // e.g. "order", "restock", "correction"
  note      String?
  orderId   String?
  order     Order? @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  saleId    String?
  sale      Sale?  @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)

  stockAfter       Int?
  reservedAfter    Int?
  safetyStockAfter Int?

  createdByUserId String?
  createdBy       User? @relation(fields: [tenantId, createdByUserId], references: [tenantId, id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([variantId])
  @@index([tenantId, variantId, createdAt])
  @@index([tenantId, orderId])
  @@index([tenantId, saleId])
}

enum InventoryMovementType {
  MANUAL_ADJUSTMENT
  MANUAL_SET
  ORDER_DECREMENT
  PURCHASE_RECEIPT
  RESERVED_ADJUSTMENT
  SAFETY_STOCK_CHANGE
  TRACKING_CHANGE
}

model Sale {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  totalAmount Float
  status      String @default("COMPLETED") // COMPLETED | REFUNDED (future)

  customerId String?
  customer   Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull)

  customerName    String?
  customerPhone   String?
  customerAddress String?

  notes String?

  createdByUserId String?
  createdBy       User? @relation("SaleCreatedBy", fields: [tenantId, createdByUserId], references: [tenantId, id])

  items     SaleItem[]
  movements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, customerId])
}

model SaleItem {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  saleId String
  sale   Sale @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id])

  quantity Int
  price    Float // Price at the time of sale

  variantId String?
  variant   ProductVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id])

  @@index([tenantId])
  @@index([tenantId, saleId])
}

model Supplier {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String
  phone   String?
  email   String?
  address String?
  notes   String?

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model PurchaseOrder {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  supplierId String?
  supplier   Supplier? @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)

  status   String @default("DRAFT") // DRAFT | ORDERED | RECEIVED | CANCELLED
  reference String?
  currency String @default("DZD")
  notes    String?

  createdByUserId String?
  createdBy       User? @relation("PurchaseOrderCreatedBy", fields: [tenantId, createdByUserId], references: [tenantId, id])

  orderedAt  DateTime?
  receivedAt DateTime?

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
}

model PurchaseOrderItem {
  id             String @id @default(uuid())
  tenantId       String
  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder  PurchaseOrder @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)

  quantityOrdered  Int
  quantityReceived Int @default(0)

  unitCost  Decimal @default(0) // prix d'achat
  salePrice Decimal? // prix de vente (optional update)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, variantId])
}

model Order {
  id          String @id @default(uuid())
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  status      String @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED
  totalAmount Float

  customerId String?
  customer   Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull)

  customerName    String
  customerPhone   String
  customerAddress String?

  deliveryMode         String            @default("home") // home | pickup | store
  shippingProvider     ShipmentProvider?
  shippingServiceLevel String?
  shippingAmount       Float?
  shippingCurrency     String            @default("DZD")
  shippingWilayaCode   String?
  shippingCommuneCode  String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingNotes        String?
  shippingEtaMinDays   Int?
  shippingEtaMaxDays   Int?

  items     OrderItem[]
  shipments Shipment[]
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, customerId])
}

model Customer {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String
  phone   String
  email   String?
  address String?

  // For future customer-auth/customer-space. Not used in MVP flows yet.
  passwordHash String?

  orders Order[]
  sales  Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, createdAt])
}

enum ShipmentProvider {
  MAYSTRO
  YALIDINE
  ECOTRACK
  ZR_EXPRESS
  SELF
}

enum ShipmentStatus {
  DRAFT
  PENDING
  REQUESTED
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  RETURNED
}

model DeliveryRate {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider         ShipmentProvider
  wilayaCode       String
  communeCode      String?
  serviceLevel     String?
  price            Decimal          @default(0)
  currency         String           @default("DZD")
  isActive         Boolean          @default(true)
  estimatedMinDays Int?
  estimatedMaxDays Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([tenantId, provider, wilayaCode, communeCode, serviceLevel])
  @@index([tenantId])
}

model Shipment {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId            String
  order              Order            @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  provider           ShipmentProvider
  providerShipmentId String?
  status             ShipmentStatus   @default(PENDING)
  serviceLevel       String?
  price              Decimal?
  currency           String           @default("DZD")
  contactName        String
  contactPhone       String
  wilayaCode         String
  communeCode        String?
  addressLine1       String
  addressLine2       String?
  notes              String?
  labelUrl           String?
  trackingUrl        String?
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  events ShipmentEvent[]

  @@unique([tenantId, provider, orderId])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([provider, tenantId])
}

model ShipmentEvent {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation("TenantShipmentEvents", fields: [tenantId], references: [id], onDelete: Cascade)
  shipmentId  String
  shipment    Shipment        @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Cascade)
  status      ShipmentStatus?
  code        String?
  description String?
  details     Json?
  rawPayload  Json?
  eventTime   DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([tenantId])
  @@index([shipmentId])
}

model OrderItem {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order   @relation(fields: [tenantId, orderId], references: [tenantId, id])
  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id])

  quantity Int
  price    Float // Price at the time of order

  variantId String?
  variant   ProductVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id])

  @@index([tenantId])
  @@index([tenantId, orderId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String? // ID of the user who performed the action (optional if system action)
  targetId  String? // ID of the target entity (e.g. tenantId)
  tenantId  String? // Tenant context usually null for super admin actions but good to have
  createdAt DateTime @default(now())
}
