generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  isOffline   Boolean  @default(true)
  isSuspended Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users                User[]
  staffRoles           TenantStaffRole[]
  staffRolePermissions TenantStaffRolePermission[]
  customers            Customer[]
  customerPointsLedger CustomerPointsLedger[]
  customerPayments     CustomerPayment[]
  cashboxes            Cashbox[]
  cashSessions         CashSession[]
  cashTransactions     CashTransaction[]
  subscription         TenantSubscription?
  payments             BillingPayment[]
  products             Product[]
  productBundleDeals   ProductBundleDeal[]
  productImages        ProductImage[]
  productOptions       ProductOption[]
  optionValues         ProductOptionValue[]
  variants             ProductVariant[]
  variantValues        ProductVariantOptionValue[]
  variantImages        ProductVariantImage[]
  inventoryMoves       InventoryMovement[]
  suppliers            Supplier[]
  supplierPayments     SupplierPayment[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderItems   PurchaseOrderItem[]
  categories           Category[]
  productCategories    ProductCategory[]
  orders               Order[]
  orderItems           OrderItem[]
  sales                Sale[]
  saleItems            SaleItem[]
  shipments            Shipment[]
  deliveryRates        DeliveryRate[]
  deliveryAccounts     TenantDeliveryAccount[]
  storeSettings        StoreSettings?
  contactInfos         TenantContactInfo[]
  domains              TenantDomain[]
  shipmentEvents       ShipmentEvent[]             @relation("TenantShipmentEvents")
  integrations         TenantIntegration[]
  metaPixels           TenantMetaPixel[]
  productMetaPixels    ProductMetaPixel[]
  maystroProductMaps   MaystroProductMapping[]
  maystroOrderMaps     MaystroOrderMapping[]
  maystroInventoryLogs MaystroInventoryEvent[]
}

model Cashbox {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(true)

  defaultForStoreSettings StoreSettings[] @relation("StoreSettingsDefaultCashbox")
  users                   User[]          @relation("UserCashbox")

  sessions     CashSession[]
  transactions CashTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model CashSession {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cashboxId String
  cashbox   Cashbox @relation(fields: [tenantId, cashboxId], references: [tenantId, id], onDelete: Cascade)

  status String @default("OPEN") // OPEN | CLOSED

  openingFloat     Decimal  @default(0)
  closingCount     Decimal?
  closingCash      Decimal?
  closingCard      Decimal?
  closingTransfer  Decimal?
  closingOther     Decimal?
  expectedClosing  Decimal?
  expectedCash     Decimal?
  expectedCard     Decimal?
  expectedTransfer Decimal?
  expectedOther    Decimal?
  difference       Decimal?

  note String?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  openedByUserId String?
  openedBy       User?   @relation("CashSessionOpenedBy", fields: [tenantId, openedByUserId], references: [tenantId, id])

  closedByUserId String?
  closedBy       User?   @relation("CashSessionClosedBy", fields: [tenantId, closedByUserId], references: [tenantId, id])

  transactions CashTransaction[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, cashboxId])
  @@index([tenantId, cashboxId, status])
  @@index([tenantId, openedAt])
}

model CashTransaction {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cashboxId String
  cashbox   Cashbox @relation(fields: [tenantId, cashboxId], references: [tenantId, id], onDelete: Cascade)

  sessionId String
  session   CashSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)

  direction String // IN | OUT
  type      String // SALE_PAYMENT | CUSTOMER_PAYMENT | SUPPLIER_PAYMENT | EXPENSE | CHARGE | TRANSFER

  amount   Decimal
  currency String  @default("DZD")
  method   String  @default("CASH") // CASH | CARD | TRANSFER | OTHER

  customerId String?
  customer   Customer? @relation("CashTxCustomer", fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation("CashTxSupplier", fields: [tenantId, supplierId], references: [tenantId, id], onDelete: SetNull)

  saleId String?
  sale   Sale?   @relation("CashTxSale", fields: [tenantId, saleId], references: [tenantId, id], onDelete: SetNull)

  orderId String?
  order   Order?  @relation("CashTxOrder", fields: [tenantId, orderId], references: [tenantId, id], onDelete: SetNull)

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation("CashTxPurchaseOrder", fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: SetNull)

  expenseCategory String?

  transferGroupId String?

  reference String?
  note      String?

  createdByUserId String?
  createdBy       User?   @relation("CashTransactionCreatedBy", fields: [tenantId, createdByUserId], references: [tenantId, id])

  createdAt DateTime @default(now())

  customerPayment CustomerPayment? @relation("CashTxCustomerPayment")
  supplierPayment SupplierPayment? @relation("CashTxSupplierPayment")

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, cashboxId, createdAt])
  @@index([tenantId, sessionId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, supplierId])
  @@index([tenantId, saleId])
  @@index([tenantId, orderId])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, transferGroupId])
}

model TenantSubscription {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planCode String // from shared pricing catalog (e.g. basic, merchant, professional)
  interval String @default("month") // month | year
  status   String @default("ACTIVE") // TRIALING | ACTIVE | CANCELED | PAST_DUE ...

  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  trialEnd           DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planCode])
}

model BillingPayment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  planCode String
  interval String @default("month") // month | year

  amountDzd Int
  currency  String @default("DA")

  method String @default("SIMULATED") // SIMULATED | MANUAL_PROOF | MYFIN | PAYSERA | BARIDIMOB | CCP | CHARGILY
  status String @default("PAID") // PAID | PENDING | REJECTED | IMPORTED

  proofUrl          String?
  notes             String?
  externalReference String?

  createdByUserId  String?
  reviewedByUserId String?

  periodStart DateTime?
  periodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([status])
}

model TenantDomain {
  id       String @id @default(uuid())
  domain   String @unique
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model TenantIntegration {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider String // TELEGRAM, FACEBOOK, TIKTOK, WHATSAPP, etc.
  config   Json? // Stores provider-specific settings, e.g. { botToken, chatId }
  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
}

model TenantDeliveryAccount {
  id       String           @id @default(uuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider ShipmentProvider
  config   Json?
  isActive Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId])
}

model StoreSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  defaultCashboxId String?
  defaultCashbox   Cashbox? @relation("StoreSettingsDefaultCashbox", fields: [tenantId, defaultCashboxId], references: [tenantId, id], onDelete: SetNull)

  logoUrl      String? // URL of the tenant's store logo
  faviconUrl   String? // URL of the tenant's store favicon
  primaryColor String  @default("#0d9488") // teal-600
  templateKey  String  @default("modern") // e.g. classic | modern
  fontFamily   String  @default("Outfit")
  language     String  @default("fr") // ar | fr | en

  announcementText      String?
  announcementScrolling Boolean @default(false)

  // Storefront legal/static pages content by language (FR/EN/AR)
  // and per-page visibility toggles for footer links.
  legalPages Json?

  // Storefront homepage configuration (carousel + sections).
  // Tenant-scoped via StoreSettings. Treated as an opaque JSON blob but validated at the API layer.
  homeConfig Json?

  cartEnabled     Boolean @default(true)
  codEnabled      Boolean @default(true)
  orderIdPrefix   String  @default("ORDR")
  minimumOrderAmountDzd Int @default(1000)
  hideOptionalAddress   Boolean @default(true)
  currencyCode    String  @default("DZD") // ISO currency code
  currencyCountry String  @default("DZ") // ISO country for flag/locale

  isCompleted              Boolean  @default(false)
  checklistDismissed       Boolean  @default(false)
  allowedDeliveryProviders String[] @default(["SELF"])
  storePickupEnabled       Boolean  @default(false)

  loyaltyEnabled                Boolean @default(false)
  loyaltyMinRedeemPoints        Int     @default(0)
  loyaltyRedeemRateDzdPerPoint  Decimal @default(1)
  loyaltyBasePoints             Decimal @default(0)
  loyaltyMarginFactor           Decimal @default(0)
  loyaltyPublicFormulaMode      String  @default("SUMMARY")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantContactInfo {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind  String
  label String?
  value String

  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, kind])
  @@index([tenantId, position])
}

model User {
  id           String           @id @default(uuid())
  email        String
  passwordHash String?
  role         String           @default("staff") // owner, admin, staff
  isSuperAdmin Boolean          @default(false)
  isActive     Boolean          @default(true)
  tokenInvalidBefore DateTime?
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  cashboxId    String?
  cashbox      Cashbox?         @relation("UserCashbox", fields: [tenantId, cashboxId], references: [tenantId, id], onDelete: SetNull)
  staffRoleId  String?
  staffRole    TenantStaffRole? @relation("StaffRoleUsers", fields: [tenantId, staffRoleId], references: [tenantId, id], onDelete: Restrict)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  inventoryMovements      InventoryMovement[]
  purchaseOrdersCreated   PurchaseOrder[]     @relation("PurchaseOrderCreatedBy")
  salesCreated            Sale[]              @relation("SaleCreatedBy")
  customerPointsCreated   CustomerPointsLedger[]
  customerPaymentsCreated CustomerPayment[]   @relation("CustomerPaymentCreatedBy")
  supplierPaymentsCreated SupplierPayment[]   @relation("SupplierPaymentCreatedBy")
  cashSessionsOpened      CashSession[]       @relation("CashSessionOpenedBy")
  cashSessionsClosed      CashSession[]       @relation("CashSessionClosedBy")
  cashTransactionsCreated CashTransaction[]   @relation("CashTransactionCreatedBy")

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, cashboxId])
  @@index([tenantId, staffRoleId])
}

model TenantStaffRole {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String

  permissions TenantStaffRolePermission[]
  users       User[]                      @relation("StaffRoleUsers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model TenantStaffRolePermission {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roleId String
  role   TenantStaffRole @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  resource String
  action   String // create | read | update | delete

  createdAt DateTime @default(now())

  @@unique([tenantId, roleId, resource, action])
  @@index([tenantId])
  @@index([tenantId, roleId])
  @@index([tenantId, resource])
}

model Category {
  id       String  @id @default(uuid())
  title    String
  slug     String
  imageUrl String?
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [tenantId, parentId], references: [tenantId, id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  products     Product[]
  productLinks ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, parentId])
}

model Product {
  id                String  @id @default(uuid())
  title             String
  slug              String
  description       String?
  miniDescription   String?
  price             Decimal @default(0)
  stock             Int     @default(0)
  lowStockThreshold Int     @default(5)

  // Promotion fields
  promotionalPrice   Decimal?
  isPromotionActive  Boolean   @default(false)
  promotionStartDate DateTime?
  promotionEndDate   DateTime?
  showCountdown      Boolean   @default(false)

  isActive      Boolean        @default(true)
  images        String[]       @default([]) // Deprecated: Use ProductImage model
  productImages ProductImage[]

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  categoryLinks ProductCategory[]

  options     ProductOption[]
  variants    ProductVariant[]
  bundleDeals ProductBundleDeal[]

  orderItems OrderItem[]
  saleItems  SaleItem[]
  maystroMappings MaystroProductMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metaPixels ProductMetaPixel[]

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model ProductCategory {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tenantId, productId, categoryId])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, categoryId])
}

model TenantMetaPixel {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String?
  pixelId String

  isActive Boolean @default(true)
  isGlobal Boolean @default(false)

  products ProductMetaPixel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, pixelId])
  @@index([tenantId])
  @@index([tenantId, isGlobal])
}

model ProductMetaPixel {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  metaPixelId String
  metaPixel   TenantMetaPixel @relation(fields: [metaPixelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tenantId, productId, metaPixelId])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, metaPixelId])
}

model ProductBundleDeal {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  bundleQty   Int
  bundlePrice Decimal @default(0)
  tag         String?

  isActive Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, productId, bundleQty])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, productId, isActive])
}

model ProductImage {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)
  isMain    Boolean @default(false)

  variants ProductVariantImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model ProductOption {
  id          String  @id @default(uuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  name        String // e.g. "Color", "Size"
  position    Int     @default(0)
  displayType String  @default("dropdown") // dropdown, button, color, image

  values ProductOptionValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model ProductOptionValue {
  id       String        @id @default(uuid())
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  optionId String
  option   ProductOption @relation(fields: [tenantId, optionId], references: [tenantId, id], onDelete: Cascade)
  label    String // e.g. "Red", "XL"
  position Int           @default(0)
  meta     String? // JSON string for swatch colors, etc.

  variantValues ProductVariantOptionValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, optionId])
}

model ProductVariant {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  sku            String   @db.VarChar(32)
  skuLocked      Boolean  @default(false)
  barcode        String?  @db.VarChar(32)
  price          Decimal  @default(0)
  promotionalPrice   Decimal?
  isPromotionActive  Boolean   @default(false)
  promotionStartDate DateTime?
  promotionEndDate   DateTime?
  showCountdown      Boolean   @default(false)
  compareAtPrice Decimal?
  cost           Decimal  @default(0) // prix d'achat (latest unit cost)
  isActive       Boolean  @default(true)

  // Inventory
  trackInventory Boolean @default(true)
  stock          Int     @default(0) // available
  reserved       Int     @default(0)
  safetyStock    Int     @default(0)

  optionValues       ProductVariantOptionValue[]
  images             ProductVariantImage[]
  movements          InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  orderItems         OrderItem[]
  saleItems          SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model ProductVariantOptionValue {
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant     @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  optionValueId String
  optionValue   ProductOptionValue @relation(fields: [tenantId, optionValueId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, variantId, optionValueId])
  @@index([tenantId])
  @@index([optionValueId])
}

model ProductVariantImage {
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  imageId   String
  image     ProductImage   @relation(fields: [tenantId, imageId], references: [tenantId, id], onDelete: Cascade)
  position  Int            @default(0)

  @@id([tenantId, variantId, imageId])
  @@index([tenantId])
  @@index([imageId])
}

model InventoryMovement {
  id               String                @id @default(uuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant        @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  type             InventoryMovementType @default(MANUAL_ADJUSTMENT)
  delta            Int // stock delta
  reservedDelta    Int                   @default(0)
  safetyStockDelta Int                   @default(0)
  reason           String // e.g. "order", "restock", "correction"
  note             String?
  orderId          String?
  order            Order?                @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  saleId           String?
  sale             Sale?                 @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)

  stockAfter       Int?
  reservedAfter    Int?
  safetyStockAfter Int?

  createdByUserId String?
  createdBy       User?   @relation(fields: [tenantId, createdByUserId], references: [tenantId, id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([variantId])
  @@index([tenantId, variantId, createdAt])
  @@index([tenantId, orderId])
  @@index([tenantId, saleId])
}

enum InventoryMovementType {
  MANUAL_ADJUSTMENT
  MANUAL_SET
  ORDER_DECREMENT
  PURCHASE_RECEIPT
  RESERVED_ADJUSTMENT
  SAFETY_STOCK_CHANGE
  TRACKING_CHANGE
}

model Sale {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  source  String  @default("POS") // POS | ORDER
  orderId String?
  order   Order?  @relation("SaleOrder", fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  totalAmount Float
  status      String @default("COMPLETED") // COMPLETED | REFUNDED (future)
  earnedPointsTotal   Int   @default(0)
  redeemedPointsTotal Int   @default(0)
  redeemedAmount      Float @default(0)

  customerId String?
  customer   Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull)

  customerName    String?
  customerPhone   String?
  customerAddress String?

  notes String?

  createdByUserId String?
  createdBy       User?   @relation("SaleCreatedBy", fields: [tenantId, createdByUserId], references: [tenantId, id])

  items            SaleItem[]
  pointsLedger     CustomerPointsLedger[]
  movements        InventoryMovement[]
  cashTransactions CashTransaction[]   @relation("CashTxSale")
  customerPayments CustomerPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, orderId])
  @@index([tenantId])
  @@index([tenantId, customerId])
}

model SaleItem {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  saleId String
  sale   Sale   @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id])

  quantity Int
  price    Float // Price at the time of sale

  variantId String?
  variant   ProductVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id])

  @@index([tenantId])
  @@index([tenantId, saleId])
}

model Supplier {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?
  openingBalance Decimal @default(0)

  purchaseOrders   PurchaseOrder[]
  payments         SupplierPayment[]
  cashTransactions CashTransaction[] @relation("CashTxSupplier")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model PurchaseOrder {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  supplierId String?
  supplier   Supplier? @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)

  status        String  @default("DRAFT") // DRAFT | ORDERED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  paymentStatus String  @default("UNPAID") // UNPAID | PARTIALLY_PAID | PAID
  totalAmount   Decimal @default(0)
  paidAmount    Decimal @default(0)

  reference String?
  currency  String  @default("DZD")
  notes     String?

  createdByUserId String?
  createdBy       User?   @relation("PurchaseOrderCreatedBy", fields: [tenantId, createdByUserId], references: [tenantId, id])

  orderedAt  DateTime?
  receivedAt DateTime?

  items            PurchaseOrderItem[]
  cashTransactions CashTransaction[]   @relation("CashTxPurchaseOrder")
  supplierPayments SupplierPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)

  quantityOrdered  Int
  quantityReceived Int @default(0)

  unitCost  Decimal  @default(0) // prix d'achat
  salePrice Decimal? // prix de vente (optional update)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, variantId])
}

model Order {
  id          String @id @default(uuid())
  publicId    String?
  tenantId    String
  tenant      Tenant @relation(fields: [tenantId], references: [id])
  status      String @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED
  totalAmount Float
  totalWithShippingAmount Float?
  earnedPointsTotal   Int   @default(0)
  redeemedPointsTotal Int   @default(0)
  redeemedAmount      Float @default(0)

  customerId String?
  customer   Customer? @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: SetNull)

  customerName    String
  customerPhone   String
  customerAddress String?
  customerIp      String?

  callStatus    String  @default("not_called")
  internalNotes String?

  deliveryMode         String            @default("home") // home | pickup | store
  shippingProvider     ShipmentProvider?
  shippingServiceLevel String?
  shippingAmount       Float?
  shippingCurrency     String            @default("DZD")
  shippingWilayaCode   String?
  shippingCommuneCode  String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingNotes        String?
  shippingEtaMinDays   Int?
  shippingEtaMaxDays   Int?
  shippingPickupPoint  Int?

  items              OrderItem[]
  pointsLedger       CustomerPointsLedger[]
  shipments          Shipment[]
  maystroMappings    MaystroOrderMapping[]
  inventoryMovements InventoryMovement[]
  cashTransactions   CashTransaction[]   @relation("CashTxOrder")
  sale               Sale?               @relation("SaleOrder")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, publicId])
  @@index([tenantId])
  @@index([tenantId, customerId])
}

model Customer {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String
  phone          String
  phoneNormalized String
  phoneRaw       String?
  email          String?
  address        String?
  openingBalance Decimal @default(0)

  // For future customer-auth/customer-space. Not used in MVP flows yet.
  passwordHash String?

  orders           Order[]
  sales            Sale[]
  pointsLedger     CustomerPointsLedger[]
  payments         CustomerPayment[]
  cashTransactions CashTransaction[] @relation("CashTxCustomer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phoneNormalized])
  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, phone])
  @@index([tenantId, phoneNormalized])
}

enum CustomerPointsDirection {
  EARN
  REDEEM
  ADJUST
}

enum CustomerPointsStatus {
  PENDING
  AVAILABLE
  CANCELLED
  CONSUMED
}

enum CustomerPointsSourceType {
  SALE
  ORDER
  MANUAL
}

model CustomerPointsLedger {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  direction CustomerPointsDirection
  status    CustomerPointsStatus
  sourceType CustomerPointsSourceType
  sourceId   String

  points Int

  saleId String?
  sale   Sale?   @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: SetNull)

  orderId String?
  order   Order?  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: SetNull)

  formulaSnapshot Json?
  expiresAt DateTime?

  createdByUserId String?
  createdBy       User?   @relation(fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sourceType, sourceId, direction])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, customerId, status])
  @@index([tenantId, saleId])
  @@index([tenantId, orderId])
}

model CustomerPayment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)

  saleId String?
  sale   Sale?   @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)

  cashTransactionId String
  cashTransaction   CashTransaction @relation("CashTxCustomerPayment", fields: [tenantId, cashTransactionId], references: [tenantId, id], onDelete: Restrict)

  amount    Decimal
  currency  String  @default("DZD")
  method    String  @default("CASH")
  reference String?
  note      String?

  createdByUserId String?
  createdBy       User?   @relation("CustomerPaymentCreatedBy", fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([tenantId, id])
  @@unique([tenantId, cashTransactionId])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, saleId])
}

model SupplierPayment {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [tenantId, purchaseOrderId], references: [tenantId, id], onDelete: Restrict)

  cashTransactionId String
  cashTransaction   CashTransaction @relation("CashTxSupplierPayment", fields: [tenantId, cashTransactionId], references: [tenantId, id], onDelete: Restrict)

  amount    Decimal
  currency  String  @default("DZD")
  method    String  @default("CASH")
  reference String?
  note      String?

  createdByUserId String?
  createdBy       User?   @relation("SupplierPaymentCreatedBy", fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([tenantId, id])
  @@unique([tenantId, cashTransactionId])
  @@index([tenantId])
  @@index([tenantId, supplierId])
  @@index([tenantId, purchaseOrderId])
}

enum ShipmentProvider {
  MAYSTRO
  YALIDINE
  ECOTRACK
  ZR_EXPRESS
  SELF
}

enum ShipmentStatus {
  DRAFT
  PENDING
  REQUESTED
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  RETURNED
}

enum MaystroSyncStatus {
  PENDING
  SYNCED
  ERROR
}

model MaystroProductMapping {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  localProductId String
  product        Product          @relation(fields: [tenantId, localProductId], references: [tenantId, id], onDelete: Cascade)

  maystroProductId String
  maystroUuid      String?

  syncStatus   MaystroSyncStatus @default(PENDING)
  lastSyncedAt DateTime?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, localProductId])
  @@unique([tenantId, maystroProductId])
  @@index([tenantId])
}

model MaystroOrderMapping {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  localOrderId String
  order       Order    @relation(fields: [tenantId, localOrderId], references: [tenantId, id], onDelete: Cascade)

  externalId    String
  maystroOrderId String?
  tracking      String?
  deliveryPrice Decimal?
  success       Boolean  @default(false)

  lastSyncedAt DateTime?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, localOrderId])
  @@unique([tenantId, externalId])
  @@index([tenantId])
}

model MaystroInventoryEvent {
  id        String @id @default(uuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  maystroProductId String?
  direction        String?
  quantity         Int?
  rawPayload       Json

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model DeliveryRate {
  id               String           @id @default(uuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider         ShipmentProvider
  wilayaCode       String
  communeCode      String?
  serviceLevel     String?
  price            Decimal          @default(0)
  currency         String           @default("DZD")
  isActive         Boolean          @default(true)
  estimatedMinDays Int?
  estimatedMaxDays Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([tenantId, provider, wilayaCode, communeCode, serviceLevel])
  @@index([tenantId])
}

model Shipment {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId            String
  order              Order            @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  provider           ShipmentProvider
  providerShipmentId String?
  status             ShipmentStatus   @default(PENDING)
  serviceLevel       String?
  price              Decimal?
  currency           String           @default("DZD")
  contactName        String
  contactPhone       String
  wilayaCode         String
  communeCode        String?
  addressLine1       String
  addressLine2       String?
  notes              String?
  labelUrl           String?
  trackingUrl        String?
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  events ShipmentEvent[]

  @@unique([tenantId, provider, orderId])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([provider, tenantId])
}

model ShipmentEvent {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation("TenantShipmentEvents", fields: [tenantId], references: [id], onDelete: Cascade)
  shipmentId  String
  shipment    Shipment        @relation(fields: [tenantId, shipmentId], references: [tenantId, id], onDelete: Cascade)
  status      ShipmentStatus?
  code        String?
  description String?
  details     Json?
  rawPayload  Json?
  eventTime   DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([tenantId])
  @@index([shipmentId])
}

model OrderItem {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order   @relation(fields: [tenantId, orderId], references: [tenantId, id])
  productId String
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id])

  quantity         Int
  price            Float // Price at the time of order
  lineTotal        Float? // Total for this line after bundle pricing (if any)
  pricingBreakdown Json?

  variantId String?
  variant   ProductVariant? @relation(fields: [tenantId, variantId], references: [tenantId, id])

  @@index([tenantId])
  @@index([tenantId, orderId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  userId    String? // ID of the user who performed the action (optional if system action)
  targetId  String? // ID of the target entity (e.g. tenantId)
  tenantId  String? // Tenant context usually null for super admin actions but good to have
  createdAt DateTime @default(now())
}

model GoogleOAuthToken {
  id           String    @id @default(uuid())
  tenantId     String
  userId       String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
}
