DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mysaas?schema=public"
JWT_SECRET="super-secret-key-change-me"
# Access token/session lifetime (default fallback is 7d)
JWT_ACCESS_TOKEN_TTL="7d"
TRUST_PROXY="true"
PLATFORM_BASE_DOMAIN="swekly.com"
NUXT_PUBLIC_PLATFORM_BASE_DOMAIN="swekly.com"
# Temporary registration lock:
# - default behavior: enabled outside tests, disabled in tests.
# - set false to disable or true to force-enable in any environment.
REGISTER_PHONE_LOCK_ENABLED="true"
# Registration is whitelisted to phone: 0540801436.

# Maystro Delivery
MAYSTRO_API_KEY=""
MAYSTRO_BASE_URL="https://backend.maystro-delivery.com/api"

# Yalidine Delivery
YALIDINE_API_ID=""
YALIDINE_API_TOKEN=""
YALIDINE_BASE_URL="https://api.yalidine.app/v1"
YALIDINE_ORIGIN_WILAYA="16" # default Algiers

# S3 / MinIO (existing)
AWS_REGION="us-east-1"
S3_ENDPOINT="http://localhost:9000"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
# Public tenant assets (product images, etc.)
S3_PUBLIC_BUCKET_NAME="products"
# Private assets (super-admin only, proofs, etc.)
S3_PRIVATE_BUCKET_NAME="private"
# Backward compatibility (if set, used as public bucket)
S3_BUCKET_NAME="products"
S3_FORCE_PATH_STYLE=true
# Optional: public URL base for serving objects.
# - Path-style: "https://nbg1.your-objectstorage.com" (URL becomes /<bucket>/<key>)
# - Path-style w/ bucket: "https://nbg1.your-objectstorage.com/<bucket>" (URL becomes /<key>)
# - Virtual-hosted: "https://<bucket>.nbg1.your-objectstorage.com" (URL becomes /<key>)
S3_PUBLIC_URL=""
# Safe-by-default: keep false in production and manage bucket policy manually.
S3_PUBLIC_READ=false

# Google Sheets order export.
# Register this exact callback URL in your Google Cloud OAuth client.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/admin/orders/export/google-callback"
# Optional; falls back to JWT_SECRET if empty.
GOOGLE_OAUTH_STATE_SECRET=""
